# Copy this file to ".env" in this same folder, then fill in the values
# below. This file is read by both `docker compose` (for build args and
# container env vars) and is never committed to git.
#
#   cp .env.example .env

# -----------------------------------------------------------------------
# Tailscale
# -----------------------------------------------------------------------

# Auth key for unattended startup. Generate one at:
#   https://login.tailscale.com/admin/settings/keys
# Recommended settings for this use case: Reusable = on (so container
# rebuilds don't burn a new key each time), Ephemeral = off (so the node
# and its Funnel config survive restarts), Tags = your choice if your
# tailnet's ACLs require tagged keys for Funnel.
#
# Leave this blank to authenticate interactively instead - on first run,
# `docker compose logs -f` will print a login URL to open in a browser.
TS_AUTHKEY=

# This container's device name on your tailnet. Combined with your
# tailnet's name, this determines the final public URL - for
# TS_HOSTNAME=electrical-bulletin-board on the ratfish-regulus tailnet,
# the app will be reachable at:
#   https://electrical-bulletin-board.ratfish-regulus.ts.net
TS_HOSTNAME=electrical-bulletin-board

# Set to "true" only if your Docker host can't grant NET_ADMIN / a real
# /dev/net/tun device to the container (see README.md Troubleshooting).
TS_USERSPACE=false

# -----------------------------------------------------------------------
# Application (backend - read at container start, see app.py)
# -----------------------------------------------------------------------

# The shared default password for every bulletin board account.
DEFAULT_USER_PASSWORD=ChangeMe123!

# Must include TS_HOSTNAME + your tailnet's ts.net suffix (no "https://",
# no trailing slash) so the backend's same-origin CSRF check accepts
# requests coming through Funnel. Comma-separate multiple hostnames.
EXTRA_TRUSTED_ORIGIN_HOSTS=electrical-bulletin-board.ratfish-regulus.ts.net

# -----------------------------------------------------------------------
# Frontend (build-time only - baked into the JS bundle when the image is
# built, NOT read at container start; changing these requires a rebuild)
# -----------------------------------------------------------------------

# Should match DEFAULT_USER_PASSWORD above - only used for UI hint text.
VITE_DEFAULT_PASSWORD=ChangeMe123!

# Should match EXTRA_TRUSTED_ORIGIN_HOSTS above (single hostname only).
VITE_EXTRA_ALLOWED_HOST=electrical-bulletin-board.ratfish-regulus.ts.net
